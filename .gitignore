# This repository builds nothing: the build artefacts are ignored inside the submodule, by the
# submodule's own .gitignore. Only what an OS or an editor drops here is listed.

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.code-workspace

# Environment
# Kept although nothing here reads one: an .env dropped at this root would otherwise be committable.
.env
*.local
